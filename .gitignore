# Python build artefacts
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
.env

# Test / type-check / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Editor / OS cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Hypothesis example database (auto-managed)
.hypothesis/

# Jupyter checkpoints
.ipynb_checkpoints/

# Notebook outputs that aren't reviewed-as-source; the canonical notebooks
# are executed in CI, not hand-edited with stale outputs.
examples/*_executed.ipynb

# Temp notebooks produced by scripts/render_notebooks_to_html.py
examples/*.patched.ipynb

# pyenv local override
.python-version

# Misc temp files
*.tmp
*.bak

# Stray uv lockfiles created outside the repo root
**/uv.lock.tmp

# Static site build output
site/

# Benchmark corpora — downloaded reference data, not work product (keep scripts/results, not the dumps)
benchmarks/**/data/
*.zip
