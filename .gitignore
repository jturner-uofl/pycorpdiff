# Hypothesis example database (auto-managed)
.hypothesis/

# uv lockfile — present in git for reproducibility, but ignore stray copies
# created outside the repo root by transient `uv` invocations.
**/uv.lock.tmp

# Jupyter checkpoints
.ipynb_checkpoints/

# LaTeX build artefacts (regenerated by the paper-pdf CI job)
paper/paper.aux
paper/paper.bbl
paper/paper.blg
paper/paper.log
paper/paper.out
paper/paper.pdf

# Notebook outputs that aren't reviewed-as-source; the canonical tutorial
# is executed in CI, not hand-edited with stale outputs.
examples/*_executed.ipynb
